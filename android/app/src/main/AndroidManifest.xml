<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- READ_PHONE_STATE: usada pelo coreTelephony quando connectionType=mobile,
         para coletar RSRP/SINR/banda/cellId. Solicitada em runtime de forma
         contextual (so quando o usuario entra na aba de sinal movel) — ver
         MainActivity.solicitarPermissaoTelefoniaContextual (issue #1671). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:name=".SignallQApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SignallQAndroidKotlin">

        <!-- GH#1690: uiMode/locale/fontScale/density/layoutDirection entraram na lista porque,
             sem eles, o SO destroi e recria esta Activity (handleRelaunchActivityInner) a cada
             troca de tema claro/escuro, idioma, tamanho de fonte ou densidade. Essa recriacao
             expoe uma race de plataforma em androidx.activity.compose.setContent
             (NullPointerException em ComponentActivity.kt:55, window.decorView.findViewById
             de android.R.id.content retornando null durante o relaunch) que ora crasha o app,
             ora deixa a tela preta e travada sem crashar. Reproduzido tanto no shell legado
             quanto no shell 2.0/Assist: nao e especifico de nenhuma tela, e pre-existente ao
             epico #1647. screenOrientation="portrait" ja impede orientation/screenSize de
             dispararem por rotacao fisica; os eixos abaixo evitam o mesmo relaunch para os
             outros gatilhos comuns. Sem onConfigurationChanged customizado: o tema reage via
             isSystemInDarkTheme()/LocalConfiguration, que ja recompoe sozinho quando o SO so
             notifica mudanca de configuracao (sem destruir a Activity). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|locale|fontScale|density|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Link público de campanha/download. A Activity abre o shell no
                 estado seguro padrão; a rota não dispara medição nem carrega
                 parâmetros externos como dados do produto. A verificação só
                 fica ativa quando o assetlinks.json usar o certificado de
                 assinatura da Play Console. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="signallq.com"
                    android:pathPrefix="/app" />
            </intent-filter>
        </activity>

        <!-- AdMob (issue #555): App ID de producao (Luiz criou a conta AdMob em 2026-07-20).
             Os 5 Ad Unit IDs de anuncio nativo por slot (ver ads/AdUnitIds.kt) tambem
             ja sao reais. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-5542349230926522~3068481614" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Remove o WorkManagerInitializer automatico da lib para usar
             inicializacao manual via Configuration.Provider no Application. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
