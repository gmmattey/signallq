{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SignallQ",
  "version": "0.1.0",
  "identifier": "com.buildea.signallq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "SignallQ",
      "width": 1280,
      "height": 820,
      "minWidth": 1024,
      "minHeight": 680,
      "resizable": true
    }],
    "security": { "csp": "default-src 'self'; connect-src 'self' https://speed.cloudflare.com https://*.workers.dev; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline';" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../../brand/signallq-symbol-512.png", "icons/icon.ico"],
    "windows": { "wix": { "language": ["pt-BR"] } }
  }
}
