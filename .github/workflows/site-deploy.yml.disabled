name: Site Deploy (Cloudflare Pages)

# Publica o site institucional público no projeto Cloudflare Pages já
# existente `signallq` (signallq.pages.dev) — reaproveitado, estava
# desativado desde 2026-07-16 quando o Console migrou pra
# signallq-admin-panel.pages.dev (ver docs/operations/ADMIN_PANEL.md).
# Nao confundir com o antigo pages-deploy.yml.disabled, que publicava o
# Console sob /console nesse mesmo projeto — esse uso foi descontinuado;
# agora o projeto serve o site institucional na raiz.

on:
  push:
    branches: [main]
    paths:
      - 'SignallQ Site/**'
      - '.github/workflows/site-deploy.yml'
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: site-deploy-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build-and-deploy:
    name: Build e deploy do site
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
      CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
      # IDs públicos de monetização. São repository variables (não secrets),
      # injetadas no build Vite para ativar exclusivamente o banner manual.
      VITE_ADSENSE_PUBLISHER_ID: ${{ vars.VITE_ADSENSE_PUBLISHER_ID }}
      VITE_ADSENSE_SLOT_RESULT: ${{ vars.VITE_ADSENSE_SLOT_RESULT }}
    steps:
      - uses: actions/checkout@v4

      - name: Check required secrets
        run: |
          if [ -n "$CLOUDFLARE_ACCOUNT_ID" ] && [ -n "$CLOUDFLARE_API_TOKEN" ]; then
            echo "Secrets do Cloudflare configurados; seguindo com o deploy."
          else
            echo "::error::Faltam secrets (CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN). O site não foi publicado."
            exit 1
          fi

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install dependencies
        working-directory: "SignallQ Site"
        run: npm ci

      - name: Build
        working-directory: "SignallQ Site"
        run: npm run build

      - name: Deploy to Cloudflare Pages (project signallq)
        working-directory: "SignallQ Site"
        run: npx wrangler pages deploy dist --project-name signallq
