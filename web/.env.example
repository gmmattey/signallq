# Site público SignallQ — variáveis do Next.js. Nada sensível aqui:
# `NEXT_PUBLIC_*` entra no bundle do navegador; SITE_INGEST_KEY é secret
# apenas do servidor (nunca coloque o valor real neste arquivo).

# Destino do CTA de download. Já tem default real em src/lib/config.ts
# (ficha do app na Play Store) — só preencha para sobrescrever.
NEXT_PUBLIC_SIGNALLQ_PLAY_STORE_URL=

# Motor de medição de /teste-de-velocidade (src/lib/config.ts). O default
# aponta para speed.cloudflare.com/__down e /__up; só sobrescreva para usar
# um endpoint de medição próprio.
NEXT_PUBLIC_SPEEDTEST_DOWNLOAD_URL=
NEXT_PUBLIC_SPEEDTEST_UPLOAD_URL=

# Secret somente do servidor, usada pelo proxy /api/track para falar com o
# Worker signallq-admin. O MESMO valor precisa existir como secret do Worker
# (`wrangler secret put SITE_INGEST_KEY`) e como variável de produção na
# Vercel. Sem ela, /api/track responde 501 e a telemetria não é enviada.
SITE_INGEST_KEY=
